[Unit]
Description=NOESIS control-plane API + dashboard (127.0.0.1:8000, served on your tailnet by tailscale serve)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/noesis/.venv/bin/python -m uvicorn services.api.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
User=noesis
Group=noesis
WorkingDirectory=/opt/noesis
EnvironmentFile=/opt/noesis/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/noesis/.venv/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/noesis /opt/noesis/config -/home/noesis/.claude -/home/noesis/.claude.json -/home/noesis/.config
StandardOutput=journal
StandardError=journal
MemoryHigh=180M
MemoryMax=220M


[Install]
WantedBy=multi-user.target
