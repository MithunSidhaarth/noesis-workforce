[Unit]
Description=NOESIS worker: every bot in one process (--shared); Claude Code CLI runs as its child
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/noesis/.venv/bin/python -m services.worker.main --shared
User=noesis
Group=noesis
WorkingDirectory=/opt/noesis
EnvironmentFile=/opt/noesis/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/noesis/.venv/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/noesis /opt/noesis/config -/home/noesis/.claude -/home/noesis/.claude.json -/home/noesis/.config
StandardOutput=journal
StandardError=journal
MemoryHigh=600M
MemoryMax=750M
Environment=NOESIS_WORKER_ID=noesis-worker
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
