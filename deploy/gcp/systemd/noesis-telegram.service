[Unit]
Description=NOESIS main Telegram bot (long polling)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/noesis/.venv/bin/python -m services.telegram.bot
User=noesis
Group=noesis
WorkingDirectory=/opt/noesis
EnvironmentFile=/opt/noesis/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/noesis/.venv/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/noesis /opt/noesis/config -/home/noesis/.claude -/home/noesis/.claude.json -/home/noesis/.config
StandardOutput=journal
StandardError=journal
MemoryHigh=130M
MemoryMax=160M


[Install]
WantedBy=multi-user.target
