# Copy to .env on the server (chmod 600). Never commit .env.
# Anything left blank simply disables that integration; the dashboard shows it as "not configured".

# ---- required -------------------------------------------------------------
NOESIS_DOMAIN=noesis.example.com          # DNS A record pointing at the VPS; Caddy gets the TLS cert
NOESIS_ADMIN_PASSWORD_HASH=               # python scripts/hash_password.py
NOESIS_SESSION_SECRET=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"
NOESIS_TIMEZONE=Asia/Kolkata
NOESIS_DRY_RUN=true                       # first-boot default only; toggle later from Settings
NOESIS_VAULT_PATH=/vault                  # server-side working copy of the Obsidian vault (see docs/DEPLOYMENT.md)

# ---- Telegram (command centre + alerts) -----------------------------------
TELEGRAM_BOT_TOKEN=                       # from @BotFather
TELEGRAM_OWNER_ID=                        # your numeric Telegram user id (not the username)

# ---- model providers (all optional; bots fall back to deterministic logic) --
# Claude Pro does NOT include API access. ANTHROPIC_API_KEY bills pay-as-you-go.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                           # Google AI Studio free tier
GROQ_API_KEY=                             # Groq free tier
OLLAMA_ENABLED=

# ---- Google (Gmail read/draft + Calendar read) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                     # python scripts/google_oauth.py (run on your own computer)

# ---- social publishing (publishing stays disabled in policies/publishing.yaml) --
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=                      # urn:li:person:xxxx
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ---- optional --------------------------------------------------------------
REDIS_URL=                                # redis://redis:6379/0 when using `--profile fast`
NOESIS_COOKIE_SECURE=true
