# Copy to .env on the server (chmod 600). Never commit .env.
# Keep comments on their own lines: Docker Compose treats `KEY=  # text` as the value "# text".
# Anything left blank simply disables that integration; the dashboard shows it as "not configured".

# ---- required -------------------------------------------------------------
# DNS A record pointing at the VPS; Caddy gets the TLS cert
NOESIS_DOMAIN=noesis.example.com
# Private mode (no domain; dashboard over Tailscale only). Uncomment to use it:
# COMPOSE_FILE=docker-compose.yml:docker-compose.private.yml
# python scripts/hash_password.py
NOESIS_ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
NOESIS_SESSION_SECRET=
NOESIS_TIMEZONE=Asia/Kolkata
# first-boot default only; toggle later from Settings
NOESIS_DRY_RUN=true
# server-side working copy of the Obsidian vault (see docs/DEPLOYMENT.md)
NOESIS_VAULT_PATH=/vault
# Where the vault folder is on the machine running Docker (default ./vault, filled by Syncthing).
# Running on your own PC (docs/WINDOWS.md)? Point it at your real vault, e.g.
# NOESIS_VAULT_HOST=/mnt/c/Users/Mithun Sidhaarth AM/NOESIS

# ---- Telegram (command centre + alerts) -----------------------------------
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your numeric Telegram user id (not the username)
TELEGRAM_OWNER_ID=

# ntfy phone notifications (free, no account): install the ntfy app, subscribe to
# your topic, put the same topic here. On public ntfy.sh anyone who knows the topic
# can read it, so only headlines are pushed; details stay in Telegram.
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=
# Optional: what tapping a push opens (e.g. https://t.me/<your bot username>)
NTFY_CLICK_URL=

# ---- reel voiceover (only for reels NOESIS makes itself) ---------------------
# auto = ElevenLabs if its key is set, else Gemini TTS with GEMINI_API_KEY, else captions only
NOESIS_VOICE=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- encryption key for tokens you paste into the dashboard (custom agents' bot tokens) --
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it in your password manager: if it changes, re-paste each agent's token.
NOESIS_SECRET_KEY=

# ---- model providers (all optional; bots fall back to deterministic logic) --
# Claude Code CLI on this machine, using your Claude Pro/Max login (run `claude` once to log in).
# Tried first for writing; when it's logged out or at its usage limit the router falls back to Gemini/Groq.
CLAUDE_CODE_ENABLED=
# optional: full path to the claude binary if it isn't on PATH
CLAUDE_CODE_BIN=
# Claude Pro does NOT include API access. ANTHROPIC_API_KEY bills pay-as-you-go.
ANTHROPIC_API_KEY=
# Google AI Studio free tier
GEMINI_API_KEY=
# Groq free tier (also transcribes voice notes sent to your custom agents, with Whisper)
GROQ_API_KEY=
OLLAMA_ENABLED=

# ---- Google (Gmail read/draft + Calendar read) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python scripts/google_oauth.py (run on your own computer)
GOOGLE_REFRESH_TOKEN=

# ---- social publishing (publishing stays disabled in policies/publishing.yaml) --
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:xxxx
LINKEDIN_AUTHOR_URN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Zernio (zernio.com, free for the first 2 accounts): posts for config/brands.yaml.
# Dashboard → API keys. Takes precedence over Postiz for a channel that has a zernio_account.
ZERNIO_API_KEY=
# Postiz (postiz.com, or self-hosted): posts for every brand in config/brands.yaml,
# without your own LinkedIn/Meta developer apps. Postiz → Settings → Public API.
POSTIZ_API_KEY=
# self-hosted only, e.g. https://postiz.example.com/api/public/v1
POSTIZ_API_URL=
# optional, read-only token with no scopes: raises GitHub's limit for the daily idea scout
GITHUB_TOKEN=

# ---- phone calls to you (same settings as the call-me Claude Code plugin; docs/PHONE.md) --
# Calls stay off until policies/phone.yaml has enabled: true. Only CALLME_USER_PHONE_NUMBER is ever dialled.
# twilio (tested path) or telnyx
CALLME_PHONE_PROVIDER=
# Twilio Account SID (Telnyx: the TeXML application / connection id)
CALLME_PHONE_ACCOUNT_SID=
# Twilio auth token (Telnyx: API key)
CALLME_PHONE_AUTH_TOKEN=
# the number calls come from, international format, e.g. +14155550100
CALLME_PHONE_NUMBER=
# YOUR phone, international format, e.g. +919812345678
CALLME_USER_PHONE_NUMBER=
# only the call-me plugin itself needs these (two-way voice); NOESIS's one-way alerts don't
CALLME_OPENAI_API_KEY=
CALLME_NGROK_AUTHTOKEN=

# ---- Google Cloud VM (deploy/gcp/setup.sh; docs/GCP.md) -----------------------
# no domain, no public ports: the dashboard is served on your tailnet by `tailscale serve`
NOESIS_PRIVATE_MODE=
# nightly backups are copied to gs://<bucket>/backups/ (leave empty to keep them on the VM only)
NOESIS_GCS_BUCKET=

# ---- optional --------------------------------------------------------------
# redis://redis:6379/0 when using `--profile fast`
REDIS_URL=
NOESIS_COOKIE_SECURE=true
# isolated (one process per bot, default) or shared (one process; for a 1 GB VPS)
NOESIS_WORKER_MODE=isolated
# override notification preferences from config/profile.yaml ("off" disables quiet hours)
NOESIS_QUIET_HOURS=
NOESIS_MAX_PINGS_PER_DAY=
# hours before an unanswered approval expires and its task is cancelled
NOESIS_APPROVAL_TTL_H=72
